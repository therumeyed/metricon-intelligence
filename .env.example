# Copy to backend/.env for local work. Never commit real values.
DATABASE_URL=postgresql+psycopg://metricon:metricon@localhost:5433/metricon
# Login is OFF by default: anyone with the URL gets full admin access. Set true to require sign-in (accounts + roles).
ADMIN_PASSWORD=          # optional: password-protect only the Admin area (reading stays open). Web service only.
REQUIRE_LOGIN=false
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_COOKIE_SECURE=false          # true behind https (Render)
APP_TIMEZONE=Australia/Sydney

# First administrator, created once on startup if no admin exists
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Anthropic - leave blank to keep AI features visibly "not connected". CLAUDE_MODEL has no default on purpose.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
ANTHROPIC_BASE_URL=

# DataForSEO Google Trends API - leave blank to keep the demand module "not connected"
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Crawler identity and limits
FETCH_CONTACT=
FETCH_TIMEOUT_S=25
FETCH_CONCURRENCY=4
FETCH_PER_HOST_DELAY_S=2
STALE_AFTER_HOURS=72
STORE_RAW_SNAPSHOTS=true
ALLOW_BROWSER_FETCH=false
# Optional allowlist credential agreed with a site owner; only sent to FETCH_EXTRA_HEADERS_HOSTS
FETCH_EXTRA_HEADERS_JSON=
FETCH_EXTRA_HEADERS_HOSTS=metricon.com.au

# Spend and volume limits (admins can override in the UI)
DATAFORSEO_DAILY_USD_LIMIT=2.0
DATAFORSEO_MONTHLY_USD_LIMIT=40.0
DATAFORSEO_MAX_REQUESTS_PER_JOB=40
DATAFORSEO_EST_COST_PER_SERP=0.002        # list price of one live SERP (10 results); an ESTIMATE
SERP_MAX_REQUESTS_PER_JOB=150
DATAFORSEO_EST_COST_PER_EXPLORE=0.011   # list price of one Live Explore task; an ESTIMATE - provider-reported cost is stored separately
ANTHROPIC_MAX_CALLS_PER_JOB=60
ANTHROPIC_DAILY_CALL_LIMIT=300
TREND_CACHE_HOURS=144
